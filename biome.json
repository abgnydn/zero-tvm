{
  "$schema": "https://biomejs.dev/schemas/2.5.1/schema.json",
  "formatter": { "enabled": false },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noExplicitAny": "off" }
    }
  },
  "files": { "includes": ["src/**", "scripts/**", "tests/**", "workers/**"] }
}
