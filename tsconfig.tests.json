{
  // Typechecks everything the app tsconfig (rootDir: src, used by the build)
  // cannot include: test sources and the Vite/Vitest config files.
  // Run via `npm run typecheck` (tsc -p tsconfig.tests.json). No emit.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "rootDir": ".",
    "types": ["@webgpu/types", "node"]
  },
  "include": ["tests/**/*.ts", "src/**/*", "vite.config.ts", "vite.lib.config.ts", "vitest.config.ts"]
}
