    given-names: Ahmet Baris
    email: hi@barisgunaydin.com
    # orcid: "https://orcid.org/0000-0000-0000-0000"   # <- add your ORCID
license: MIT
repository-code: "https://github.com/abgnydn/zero-tvm"
url: "https://zerotvm.com"
version: 0.2.0
date-released: "2026-06-25"
keywords:
  - webgpu
  - wgsl
  - llm
  - phi-3
  - inference
  - browser
  - from-scratch
  - mlc-llm
