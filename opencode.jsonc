{
  "$schema": "https://opencode.ai/config.json",
  // Project overlay on ~/.config/opencode/opencode.jsonc. Only the two MCP
  // servers this repo's work actually needs: context7 for version-accurate
  // WebGPU/wgpu/WebRTC docs, chrome-devtools for WebGPU perf traces.
  "mcp": {
    "context7": { "enabled": true },
    "chrome-devtools": { "enabled": true }
  }
}
