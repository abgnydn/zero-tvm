{
  "name": "zero-tvm",
  "version": "0.2.0",
  "description": "Phi-3-mini running in a browser on 10 hand-written kernel roles across 55 WGSL kernels (37 files + an 18-variant generator). No TVM, no WebLLM runtime, no compiler.",
  "type": "module",
  "license": "MIT",
  "author": "Ahmet Baris Gunaydin",
  "keywords": [
    "webgpu",
    "wgsl",
    "llm",
    "phi-3",
    "inference",
    "browser",
    "from-scratch",
    "no-tvm"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "lint": "npm run typecheck",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/tokenizer tests/unit",
    "test:e2e": "vitest run tests/e2e",
    "test:kernels": "node tests/kernels/run.mjs",
    "test:kernels:qwen": "node tests/kernels/compile-qwen.mjs",
    "test:kernels:qwen35": "node tests/kernels/compile-qwen35.mjs",
    "gen:tokenizer-fixtures": "node scripts/gen-tokenizer-fixtures.mjs",
    "gen:tokenizer-fixtures-qwen": "node scripts/gen-tokenizer-fixtures-qwen.mjs",
    "bench": "node bench/run.mjs",
    "bench:sync": "node bench/sync-docs.mjs",
    "check": "npm run typecheck && npm run test",
    "test:kernels:real": "node tests/kernels/real-weights.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@kmamal/gpu": "^0.2.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "@types/node": "^22.13.0",
    "@webgpu/types": "^0.1.69",
    "@wllama/wllama": "^3.5.1",
    "puppeteer": "^24.40.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.2"
  }
}
