{
  "name": "zero-tvm",
  "version": "0.1.0",
  "description": "Phi-3-mini running in a browser on 10 hand-written kernel roles across 27 WGSL files. No TVM, no WebLLM runtime, no compiler.",
  "type": "module",
  "license": "MIT",
  "author": "Ahmet Baris Gunaydin",
  "keywords": [
    "webgpu",
    "wgsl",
    "llm",
    "phi-3",
    "inference",
    "browser",
    "from-scratch",
    "no-tvm"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run",
    "test:kernels": "node tests/kernels/run.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.80"
  },
  "devDependencies": {
    "@kmamal/gpu": "^0.2.1",
    "@webgpu/types": "^0.1.69",
    "puppeteer": "^24.40.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.0",
    "vitest": "^4.1.2"
  }
}
